  "source_mysql_schema": "CREATE TABLE `original_data` (\n  `id` bigint unsigned NOT NULL AUTO_INCREMENT,\n  `date_raw` char(10) NOT NULL COMMENT 'CSV 日期，尚未清理',\n  `hour_raw` char(2) NOT NULL COMMENT 'CSV 時段，尚未清理',\n  `entry_station_raw` varchar(64) NOT NULL COMMENT 'CSV 進站，尚未清理',\n  `exit_station_raw` varchar(64) NOT NULL COMMENT 'CSV 出站，尚未清理',\n  `passenger_count_raw` varchar(20) NOT NULL COMMENT 'CSV 人次，尚未清理',\n  `source_month` char(6) NOT NULL COMMENT '來源檔年月 YYYYMM',\n  `source_row` bigint unsigned NOT NULL COMMENT '來源 CSV 的資料列號，自 1 起算，不含標頭',\n  `imported_at` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uq_original_source` (`source_month`,`source_row`),\n  KEY `ix_original_station_time` (`date_raw`,`hour_raw`,`entry_station_raw`)\n) ENGINE=InnoDB AUTO_INCREMENT=15970081 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='臺北捷運逐日分時站間 OD 原始資料；不可在此表直接清理或覆蓋'",
