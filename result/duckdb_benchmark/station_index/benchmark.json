  "queries": {
    "q1_beimen_day": {
      "label": "北門單日 18–23 時逐時人次",
      "mysql_sql": "SELECT source_hour,SUM(passengers) AS total\n                  FROM bench_duckdb_20261020t083841z_03aab8f3.od WHERE origin_station='北門'\n                  AND service_date='2026-07-29' AND source_hour BETWEEN 18 AND 23\n                  GROUP BY source_hour ORDER BY source_hour",
      "duckdb_sql": "SELECT source_hour,SUM(passengers) AS total\n                  FROM od WHERE origin_station='北門'\n                  AND service_date='2026-07-29' AND source_hour BETWEEN 18 AND 23\n                  GROUP BY source_hour ORDER BY source_hour"
    },
    "q2_four_stations": {
      "label": "四站全月晚間逐日逐時人次",
      "mysql_sql": "SELECT service_date,origin_station,source_hour,SUM(passengers) AS total\n                  FROM bench_duckdb_20261020t083841z_03aab8f3.od WHERE origin_station IN ('北門','大橋頭站','雙連','民權西路')\n                  AND source_hour BETWEEN 18 AND 23\n                  GROUP BY service_date,origin_station,source_hour\n                  ORDER BY service_date,origin_station,source_hour",
      "duckdb_sql": "SELECT service_date,origin_station,source_hour,SUM(passengers) AS total\n                  FROM od WHERE origin_station IN ('北門','大橋頭站','雙連','民權西路')\n                  AND source_hour BETWEEN 18 AND 23\n                  GROUP BY service_date,origin_station,source_hour\n                  ORDER BY service_date,origin_station,source_hour"
    },
    "q3_network_hourly": {
      "label": "全站全月依車站與時段彙總",
      "mysql_sql": "SELECT origin_station,source_hour,SUM(passengers) AS total\n                  FROM bench_duckdb_20261020t083841z_03aab8f3.od GROUP BY origin_station,source_hour\n                  ORDER BY origin_station,source_hour",
      "duckdb_sql": "SELECT origin_station,source_hour,SUM(passengers) AS total\n                  FROM od GROUP BY origin_station,source_hour\n                  ORDER BY origin_station,source_hour"
    },
    "q4_top_od": {
      "label": "全月非零 OD 彙總前 20 名",
      "mysql_sql": "SELECT origin_station,destination_station,SUM(passengers) AS total\n                  FROM bench_duckdb_20261020t083841z_03aab8f3.od WHERE passengers>0\n                  GROUP BY origin_station,destination_station\n                  ORDER BY total DESC,origin_station,destination_station LIMIT 20",
      "duckdb_sql": "SELECT origin_station,destination_station,SUM(passengers) AS total\n                  FROM od WHERE passengers>0\n                  GROUP BY origin_station,destination_station\n                  ORDER BY total DESC,origin_station,destination_station LIMIT 20"
    }
  },
